# Docker Compose 镜像配置。使用远程镜像时填写 Docker Hub 仓库名。
MOCK_IMAGE_REPOSITORY=mock-ai-api
MOCK_IMAGE_TAG=dev

# 端口配置。默认仅允许从本机访问。
MOCK_HOST_IP=127.0.0.1
MOCK_HOST_PORT=18080
MOCK_CONTAINER_PORT=8080

# 默认模型名。
MOCK_MODEL=mock-gpt

# 流式首个文本 Token 等待时间，使用 Go 时长格式，范围为 0s..1h。
MOCK_TTFT=0s
# 流式输出速率，0 表示不等待，范围为 0..1000000。
MOCK_TPS=0
# 非流式响应延迟，使用 Go 时长格式，范围为 0s..1h。
MOCK_LATENCY=0s
# 实际输出 Token 数，支持单值或 min..max，范围为 1..1000000。
MOCK_OUTPUT_TOKENS=16
